# Railway PostgreSQL
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# SMTP (비밀번호 재설정 메일 전송용 — 미설정 시 콘솔 로그로 fallback)
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# SMTP_PASS 는 Google 계정 > 보안 > 앱 비밀번호에서 발급 (2단계 인증 필요, 공백 없이 16자리)
# ⚠️ Gmail은 From 주소를 인증 계정(SMTP_USER)으로 강제함.
#    → SMTP_FROM 의 주소 부분은 반드시 SMTP_USER 와 동일한 Gmail 주소로 설정할 것.
#    (no-reply@... 같은 임의 도메인은 거부되거나 Gmail 주소로 덮어쓰기 됨)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="My D-day <your-account@gmail.com>"
